---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import FriendSection from "@components/organisms/FriendSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { commentConfig, resolveCommentOptions, siteConfig } from "@/config";
import { friendsConfig } from "@/config/friendsConfig";
import { getFriendsList } from "../data/friends";

if (!friendsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(friendsConfig.title, I18nKey.friends);
const pageDescription = resolveI18nText(friendsConfig.description, I18nKey.friendsBanner);

// Optional notes under the list (link requirements, site info): src/content/spec/friends.md
const friendsPost = await getEntry("spec", "friends");
const rendered = friendsPost ? await render(friendsPost) : null;
const markdownStylesheetAssets = rendered
	? await getMarkdownStylesheetAssets(rendered.remarkPluginFrontmatter.markdownSyntaxes)
	: [];
const FriendsContent = rendered?.Content;
const hasComments = Boolean(resolveCommentOptions(commentConfig));
---

<MainGridLayout title={pageTitle} description={pageDescription} page="friends" hasComments={hasComments}>
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    <FriendSection friends={getFriendsList()} title={pageTitle} subtitle={pageDescription} client:visible></FriendSection>

    {FriendsContent && (
        <div class="flex w-full rounded-[var(--shape-corner-l)] overflow-hidden relative min-h-32 mt-4">
            <Card color="var(--card-bg)" radius="l" class="z-10 p-6 lg:p-8 relative w-full">
                <Markdown class="mt-2">
                    <FriendsContent />
                </Markdown>
            </Card>
        </div>
    )}

    {FriendsContent && (
        <style is:global>
            /* friends.md 正文里的申请表单按钮（raw HTML <a class="friends-apply-button">），对齐 M3E filled small 按钮 */
            .friends-apply-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                height: 2.5rem;
                padding: 0 1.5rem;
                border-radius: var(--shape-corner-m);
                background: var(--primary);
                color: var(--on-primary);
                font: var(--m3e-type-label-large);
                text-decoration: none;
                --m3e-state-color: var(--on-primary);
                box-shadow: var(--m3e-elevation-0);
                transition: box-shadow var(--m3e-duration-short) var(--m3e-easing-standard);
            }
            .friends-apply-button:hover {
                box-shadow: var(--m3e-elevation-1);
            }
            .friends-apply-button:focus-visible {
                outline: 2px solid var(--primary);
                outline-offset: 2px;
            }
        </style>
    )}

    <CommentSection
        context={{
            key: "page:friends",
            // Existing Twikoo comments are keyed by this exact path
            path: "/friends/",
            title: pageTitle,
            language: siteConfig.lang,
        }}
        class="mt-4"
    />
</MainGridLayout>
