---
import MomentSection from "@components/organisms/MomentSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedMoments } from "@utils/content-utils";
import { resolveMomentAuthor } from "@utils/moment-author";
import { commentConfig, momentsConfig, resolveCommentOptions } from "@/config";
import { resolveI18nText } from "@utils/i18n-utils";

if (!momentsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(momentsConfig.title, I18nKey.moments);
const pageDescription = resolveI18nText(momentsConfig.description, I18nKey.momentsBanner);

const moments = await getSortedMoments();
const author = await resolveMomentAuthor();
// 评论关闭时卡片不渲染评论入口（零额外负担）
const commentsEnabled = Boolean(resolveCommentOptions(commentConfig));
---

<MainGridLayout title={pageTitle} description={pageDescription} page="moments">
    <MomentSection {moments} {author} {commentsEnabled} title={pageTitle} subtitle={pageDescription} client:visible></MomentSection>
</MainGridLayout>
