---
import type { CollectionEntry } from 'astro:content'
import { commentConfig } from '@/config'
import Twikoo from './Twikoo.astro'

// Pass `post` on post pages; pass `path` on standalone pages (e.g. friends)
interface Props {
  post?: CollectionEntry<'posts'>
  path?: string
}

const { post } = Astro.props
// No trailing slash: existing Twikoo comments are keyed by this exact path
const path = post ? `/posts/${post.id}` : (Astro.props.path ?? Astro.url.pathname)

let commentService = ''
if (commentConfig?.twikoo) {
  commentService = 'twikoo'
}
---
<div class="card-base p-6 mb-4">
  {commentService === 'twikoo' && <Twikoo path={path} />}
</div>
