{
  "redirects": [
    { "source": "/archive/tag/:tag/", "destination": "/archive/?tag=:tag", "permanent": true },
    { "source": "/archive/tag/:tag", "destination": "/archive/?tag=:tag", "permanent": true },
    { "source": "/archive/category/uncategorized/", "destination": "/archive/?uncategorized=true", "permanent": true },
    { "source": "/archive/category/:category/", "destination": "/archive/?category=:category", "permanent": true },
    { "source": "/archive/category/:category", "destination": "/archive/?category=:category", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
